# ---------------------------------------------------------------------------
# ajc-dev_code-auditor environment variables
#
# Copy this file to `.env` and fill in the key(s) for the provider(s) you want
# to use. Only ONE key is required: the default provider is Google Gemini,
# whose free tier needs no credit card. All other keys are optional and are
# only consulted if you select that provider or list it in `fallbackProviders`.
#
# See README.md -> "Free LLM providers" for where to obtain each key.
# ---------------------------------------------------------------------------

# Google Gemini (DEFAULT). Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq free tier. https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter (use any model with the ":free" suffix). https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Mistral free evaluation tier. https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Paid providers (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama needs no key. Override the local endpoint if it is not on the default port.
# OLLAMA_BASE_URL=http://localhost:11434/v1

# ---------------------------------------------------------------------------
# Optional overrides. Each of these can also be set via CLI flags or
# auditor.config.json (CLI > config file > env > built-in defaults).
# ---------------------------------------------------------------------------
# AUDITOR_PROVIDER=gemini
# AUDITOR_MODEL=gemini-3.5-flash-lite
# AUDITOR_BASE_URL=
# AUDITOR_FALLBACK_PROVIDERS=groq,openrouter,ollama
# AUDITOR_CONCURRENCY=1
# AUDITOR_OUT_DIR=./audit-output
# AUDITOR_LOG_LEVEL=info
